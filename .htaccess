<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType audio/mpeg "access plus 1 year"
  ExpiresByType audio/ogg "access plus 1 year"
  ExpiresByType audio/wav "access plus 1 year"
  ExpiresByType audio/webm "access plus 1 year"
  ExpiresByType audio/mp4 "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
</IfModule>

AddType image/avif .avif

Redirect 301 /memetic-warfare/live-experiment/ /live-experiment/

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(content|studio|scripts|\.studio-uploads|\.studio-backups)(/|$) - [F,L]
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(avif|webp|png|ico|css|js|mp3|ogg|oga|wav|webm|m4a)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.(html|xml|txt|webmanifest)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>

  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://www.googletagmanager.com https://static.cloudflareinsights.com https://cdnjs.cloudflare.com https://w.soundcloud.com; connect-src 'self' https://www.google-analytics.com https://analytics.google.com https://region1.google-analytics.com https://w.soundcloud.com https://api.soundcloud.com https://api-v2.soundcloud.com; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; frame-src https://w.soundcloud.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; upgrade-insecure-requests;"
</IfModule>
